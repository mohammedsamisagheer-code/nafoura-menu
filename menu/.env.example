# WhatsApp Cloud API — set these in Netlify dashboard for auto-send
# WHATSAPP_TOKEN=EA...
# WHATSAPP_PHONE_NUMBER_ID=123456789
# WHATSAPP_TO_NUMBER=21891XXXXXXX

# Fallback: restaurant WhatsApp number for wa.me deep link (used in config.ts)
# VITE_WHATSAPP_NUMBER=218000000000

# Google Maps API key (optional, has embedded fallback)
# VITE_GOOGLE_MAPS_API_KEY=your_key_here

# Delivery fee in LYD (optional, defaults to 5)
# VITE_DELIVERY_FEE=5
