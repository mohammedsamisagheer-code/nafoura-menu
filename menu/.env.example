# ─── Required for production ───
# Set these in Netlify dashboard. Without them, orders fall back to wa.me deep link.
# WHATSAPP_TOKEN=EA...
# WHATSAPP_PHONE_NUMBER_ID=123456789
# WHATSAPP_TO_NUMBER=21891XXXXXXX

# ─── Optional overrides ───
# WhatsApp number used for wa.me fallback (config.ts has a fallback default)
# VITE_WHATSAPP_NUMBER=218926547333
# Google Maps API key (config.ts has an embedded fallback key)
# VITE_GOOGLE_MAPS_API_KEY=your_key_here
# Delivery fee in LYD (defaults to 5)
# VITE_DELIVERY_FEE=5
